 {
      const cleanUrl = url.replace(/^https?:\/\//, "").replace(/\/$/, "");
      const res = await fetch(`/api/audit?url=${cleanUrl}`);
      const json = await res.json();
      setData(json);
    } catch (e) {
      setData({ error: "error-v5", score: 0, words: 0 });
    }
    setLoading(false);
  };

  return (
    <div style={{background:"black", color:"white", minHeight:"100vh", padding:"20px", fontFamily:"system-ui"}}>
      <h1 style={{fontSize:"32px", fontWeight:"bold"}}>RankPilot <span style={{color:"#22c55e"}}>V7</span></h1>
      <p style={{color:"#888"}}>Audit SEO pour restos Casa - GreenBlack.ma</p>

      <div style={{marginTop:"20px", display:"flex", gap:"10px"}}>
        <input
          value={url}
          onChange={(e) => setUrl(e.target.value)}
          placeholder="greenblack.ma"
          style={{flex:1, padding:"12px", borderRadius:"10px", border:"1px solid #333", background:"#111", color:"white"}}
        />
        <button onClick={audit} style={{padding:"12px 20px", background:"#22c55e", color:"black", borderRadius:"10px", fontWeight:"bold"}}>
          {loading ? "..." : "Auditer"}
        </button>
      </div>

      {data && (
        <div style={{marginTop:"25px", border:"1px solid #222", borderRadius:"15px", padding:"20px", background:"#111"}}>
          
          <div style={{display:"flex", justifyContent:"space-between", alignItems:"center"}}>
            <h2 style={{fontSize:"20px", fontWeight:"bold"}}>{url}</h2>
            <div style={{fontSize:"32px", fontWeight:"bold", color: data.score >= 90 ? "#22c55e" : "#facc15"}}>
              {data.score}/100
            </div>
          </div>

          <div style={{fontSize:"12px", color:"#666", marginTop:"5px"}}>
            {data.status} - {data.time} - {data.mode} - {data.words} mots
          </div>

          <div style={{marginTop:"15px", fontSize:"14px", lineHeight:"1.6"}}>
            <div>Title: {data.title || "N/A"} [{data.titleLen || 0} chars]</div>
            <div>Desc: {data.desc || "N/A"} [{data.descLen || 0} chars]</div>
            <div>H1: {data.h1Count || 0}</div>
            <div>OG Image: {data.ogImage ? "YES ✅" : "NO ❌"}</div>
          </div>

          {/* IMAGE SI ELLE EXISTE */}
          {data.ogImage && (
            <img src={data.ogImage} alt="OG preview" style={{marginTop:"15px", maxWidth:"100%", borderRadius:"10px", border:"1px solid #333"}} />
          )}

          {/* V7 FIX - QUAND PAS D'OG IMAGE - C'EST LE CAS GREENBLACK */}
          {!data.ogImage && data.score > 0 && (
            <div style={{marginTop:"18px", padding:"16px", background:"#052e16", border:"1px solid #22c55e", borderRadius:"12px"}}>
              <div style={{fontWeight:"bold", color:"white", fontSize:"16px"}}>🚀 PASSER À 100/100:</div>
              <div style={{fontSize:"14px", color:"#ccc", marginTop:"8px", lineHeight:"1.5"}}>
                Le seul défaut de {url}: <b style={{color:"white"}}>Pas d'OG Image</b><br/>
                Sans image, votre lien sur WhatsApp / Instagram n'affiche pas votre plat. Vous perdez 30% de clics.
              </div>
              <div style={{fontSize:"13px", marginTop:"12px", color:"white", background:"black", padding:"10px", borderRadius:"8px"}}>
                ✅ FIX en 15 min:<br/>
                Ajouter dans &lt;head&gt;:<br/>
                <code style={{color:"#22c55e"}}>&lt;meta property="og:image" content="https://{url}/img/plat.jpg" /&gt;</code>
              </div>
              <div style={{marginTop:"12px", fontWeight:"bold", color:"white"}}>
                💰 Je vous le fais + photo optimisée pour 399 DH
              </div>
              <a 
                href={`https://wa.me/212600000000?text=Salut, j'ai audité ${url} : ${data.score}/100. Il ne manque que OG Image pour passer à 100/100. Je vous le fais pour 399DH. Voir audit RankPilot`}
                target="_blank"
                style={{display:"inline-block", marginTop:"12px", background:"#22c55e", color:"black", padding:"12px 20px", borderRadius:"25px", fontWeight:"bold", textDecoration:"none"}}
              >
                📲 Envoyer devis WhatsApp
              </a>
            </div>
          )}

          {data.score === 0 && (
            <div style={{marginTop:"15px", color:"#ef4444", fontSize:"14px"}}>
              Domaine introuvable - Vérifiez l'orthographe (ex: greenback.ma ≠ greenblack.ma)
            </div>
          )}

        </div>
      )}

      <div style={{marginTop:"30px", color:"#444", fontSize:"12px"}}>
        RankPilot V7 BUSINESS - Spécial Restauration Casa
      </div>
    </div>
  );
}
